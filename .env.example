# Valores compartidos entre módulos. scripts/up.sh los copia al .env de cada módulo elegido;
# lo que falte te lo pregunta y lo guarda aquí. Este fichero no se sube al repo.

# Tu usuario, para que los ficheros generados no queden como root
PUID=1000
PGID=1000

# Carpeta del host que vigila tu cliente de torrents (Dieta Sonora deja ahí las descargas)
# WATCH_TORRENTS_HOST_PATH=/ruta/a/watch_torrents

# LASTFM_API_KEY=
# DISCOGS_TOKEN=
# YOUTUBE_API_KEY=
# MUSPY_USERID=
# NAS_URL=
# NAS_API_KEY=
# SETTINGS_PASSWORD=
